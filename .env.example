# Copy to .env and fill in.
SOCIETY_NAME=Green Meadows
PORT=3000
TZ_SOCIETY=Asia/Kolkata

# First committee admin (created on first start only)
ADMIN_NAME=Committee Admin
ADMIN_PHONE=9000000000
ADMIN_PASSWORD=change-me-now

# Set to 1 when served over HTTPS (it should be, in production)
COOKIE_SECURE=1

# Phone notifications: run `npm run vapid` and paste the two keys here
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:committee@example.com

# Where the database lives (back this file up!)
DB_FILE=./data/gatepass.db
