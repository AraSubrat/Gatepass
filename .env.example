# Copy to .env and fill in.
SOCIETY_NAME=Green Meadows
PORT=3000
TZ_SOCIETY=Asia/Kolkata

# First committee admin (created on first start only)
ADMIN_NAME=Committee Admin
ADMIN_PHONE=9000000000
ADMIN_PASSWORD=change-me-now

# Set to 1 when served over HTTPS (it should be, in production)
COOKIE_SECURE=1

# Phone notifications: run `npm run vapid` and paste the two keys here
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:committee@example.com

# Where the database lives (back this file up!)
DB_FILE=./data/gatepass.db

# ---- Native Android / iOS apps ----
# Address the phone apps connect to (used by `npm run build:mobile`)
GATEPASS_SERVER_URL=https://gate.yoursociety.in
# Extra web origins allowed to call the API (the apps' own origins are always allowed)
CORS_ORIGINS=

# Android push: Firebase service-account JSON (file path or the JSON itself)
FIREBASE_SERVICE_ACCOUNT=./secrets/firebase-service-account.json

# iOS push: Apple APNs auth key (.p8) — Apple Developer → Keys
APNS_KEY=./secrets/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.gatepass.society
# 1 for App Store / TestFlight builds, empty for builds run from Xcode
APNS_PRODUCTION=
