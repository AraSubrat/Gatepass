{
  "name": "gatepass",
  "version": "1.0.0",
  "description": "A simple, ad-free society app: gate entry/exit, community forum, amenity booking and helpdesk.",
  "private": true,
  "type": "commonjs",
  "main": "server/index.js",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning server/index.js",
    "dev": "node --no-warnings=ExperimentalWarning --watch server/index.js",
    "test": "node --no-warnings=ExperimentalWarning --test test/*.test.js",
    "vapid": "node -e \"const k=require('web-push').generateVAPIDKeys();console.log('VAPID_PUBLIC_KEY='+k.publicKey+'\\nVAPID_PRIVATE_KEY='+k.privateKey)\""
  },
  "dependencies": {
    "express": "^5.1.0",
    "web-push": "^3.6.7"
  }
}
